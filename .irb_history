product = Product.first
\
# Attachmentオブジェクトを確認\
product.images.attachments\
# => ActiveStorage::Attachment の配列が返る\
\
# 個別に詳細を確認\
product.images.attachments.each do |attachment|\
  puts "id: #{attachment.id}"\
  puts "record_type: #{attachment.record_type}"\
  puts "record_id: #{attachment.record_id}"\
  puts "name: #{attachment.name}"\
  puts "blob_id: #{attachment.blob_id}"\
end
product.images.each do |image|\
  blob = image.blob\
  puts "id: #{blob.id}"\
  puts "filename: #{blob.filename}"       # 元のファイル名\
  puts "key: #{blob.key}"                 # S3上のユニークキー\
  puts "content_type: #{blob.content_type}" \
  puts "byte_size: #{blob.byte_size}"\
  puts "metadata: #{blob.metadata}"\
  puts "service_url: #{blob.service_url(expires_in: 1.hour)}" # 一時的アクセスURL\
end
